# Copy to .env in the repo root. .env is gitignored.
# Account locator from the Snowsight URL: https://<account>.snowflakecomputing.com
# Do not append .snowflakecomputing.com. Use the hyphenated org-account form.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Trial strong auth: PKCS#8 key outside the repo (same file Cloud uses).
# Default if unset: ~/.snowflake/dbt_cloud_rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Browser SSO only if you are not using the key pair.
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_PASSWORD=

# Needed for day1_setup.sql and teardown.sql (ACCOUNTADMIN).
# dbt uses TRANSFORMER via SNOWFLAKE_DBT_ROLE.
SNOWFLAKE_ROLE=ACCOUNTADMIN
