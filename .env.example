# Copy to .env in the repo root. .env is gitignored.
# Account locator from the Snowsight URL: https://<account>.snowflakecomputing.com

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Browser SSO (matches the trial SAML login). Comment this out and set
# SNOWFLAKE_PASSWORD instead if you use username/password.
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_PASSWORD=

# Needed for day1_setup.sql and teardown.sql
SNOWFLAKE_ROLE=ACCOUNTADMIN
